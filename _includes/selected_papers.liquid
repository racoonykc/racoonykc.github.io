<div class="publications">
  <p class="publication-note">* indicates equal contribution.</p>
  {% bibliography --group_by none --query @*[selected=true]* %}
</div>
{% if include.limit %}
<style>
  .publications > .bibtex-entry:nth-child(n+{{ include.limit | plus: 1 }}) {
    display: none;
  }
</style>
{% endif %}
